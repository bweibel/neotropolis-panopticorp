;WIPE_END
G1 E-.04 F2100
G1 Z3.3 F720
M107
;TYPE:Custom
; Filament-specific end gcode
G1 Z3.9 F720 ; Move print head up
G1 X0 Y200 F3600 ; park
G1 Z51.9 F720 ; Move print head further up
G4 ; wait
M221 S100 ; reset flow
M900 K0 ; reset LA

M104 S0 ; turn off temperature
M140 S0 ; turn off heatbed
M107 ; turn off fan
M84 ; disable motors
M73 P100 R0
M73 Q100 S0
